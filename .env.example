# Athena CPA — environment template
# Copy to .env and fill in real values. Do NOT commit .env.
#
# IMPORTANT (CPA migration): create a DEDICATED Supabase project and Clerk
# application for CPA. Do not reuse the ACT product's project/app — mixing
# them will mix user accounts and data between products.

# Clerk — create a new application at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_new_cpa_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_new_cpa_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase — create a new project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-new-cpa-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_new_cpa_key
DATABASE_URL=postgresql://postgres:your_password@your-new-cpa-project-pooler.supabase.com:6543/postgres

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Athena CPA <onboarding@resend.dev>
APP_URL=http://localhost:3000

# Cron job auth — Vercel sets this automatically and adds it as Authorization: Bearer <secret>
# For local testing, set any secret string here
CRON_SECRET=your_cron_secret_here

AGENT_SERVICE_URL=http://localhost:8080

# ElevenLabs — required for tutor TTS and speech-to-text
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Stripe — create a new product/pricing set for CPA (separate from ACT pricing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRICE_ID=price_your_price_id

# Canvas LMS Integration — carried over from ACT; confirm with client whether
# CPA (adult professional audience) needs LMS integration at all
CANVAS_CLIENT_ID=pending_from_client
CANVAS_CLIENT_SECRET=pending_from_client
# Optional: teacher token for direct grade passback
# CANVAS_INSTRUCTOR_TOKEN=

# Web Push (VAPID keys) — generate a new keypair per project
# Generate once: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_new_vapid_public_key
VAPID_PRIVATE_KEY=your_new_vapid_private_key
